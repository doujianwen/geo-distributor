# ============================================================
# GEO Distributor — 环境变量示例
# 复制为 .env 并按需修改；也可直接在 shell 中 export
# ============================================================

# ------------------------------------------------------------
# P0-5 持久化后端
# ------------------------------------------------------------
# 未设置 → 内存仓储（InMemoryRepository），进程重启后数据丢失
# 设为 .db 路径 → SQLite 持久化，跨重启保留
# 设为 1/true   → 启用并落到默认路径 data/geo_distributor.db
#
# GEO_DISTRIBUTOR_DB=data/geo_distributor.db

# ------------------------------------------------------------
# Elmo 适配器（可选；当前默认走 geo-collector 直连 SQLite，
# 无需 Elmo。配置方式见 config/settings.yaml）
# ------------------------------------------------------------
# ⚠️ 不要把 API key 写进 settings.yaml 并入库——请走环境变量
# ELMO_API_KEY=
# ELMO_BASE_URL=

# ------------------------------------------------------------
# B-2 认证（远程 / 多用户商业部署）
# ------------------------------------------------------------
# 所有 /api 端点（/health 除外）都需要 X-API-Key 头。
# 密钥→ tenant 绑定是**唯一**租户来源：X-Tenant-ID 仅作可选声明，
# 与密钥绑定冲突时返回 403。
#
# 格式：TENANT_ID:API_KEY:ROLE[,TENANT_ID:API_KEY:ROLE...]
# ROLE 取值（复用 geo_distributor.models.tenant.UserRole）：
#   DISTRIBUTOR_ADMIN  - 租户管理员，可写，仅本租户
#   DISTRIBUTOR_USER   - 租户成员，可写，仅本租户
#   CLIENT_VIEWER      - 只读，仅本租户
#   HQ_TECHNICAL       - HQ 技术，可写，可跨租户
#   HQ_MANAGEMENT      - HQ 管理，可写，可跨租户
#
# 生成密钥（推荐 python -c "import secrets;print(secrets.token_urlsafe(32))"）
#
# 生产环境务必设置 GEO_DISTRIBUTOR_ENV=production —— 内置开发密钥
# 仅在 dev/test 下加载。
#
# GEO_DISTRIBUTOR_ENV=production
# GEO_DISTRIBUTOR_API_KEYS=DST-001:sk-xxxxxxxx:DISTRIBUTOR_ADMIN,DST-002:sk-yyyyyyyy:DISTRIBUTOR_USER

# 本地开发可启用（会加载内置密钥 sk-dev-key-localhost / DST-LOCAL-DEV）
# GEO_DISTRIBUTOR_ENV=dev

# CORS：WordPress 域名必须在此白名单中（多个用逗号分隔）
# GEO_DISTRIBUTOR_CORS_ORIGINS=https://your-wordpress-site.com

# ------------------------------------------------------------
# 限流（生产默认 120/min，单租户维度）
# ------------------------------------------------------------
# 令牌桶参数：速率（每分钟请求数）+ 桶容量（突发上限）
# GEO_DISTRIBUTOR_RATE_LIMIT=120
# GEO_DISTRIBUTOR_RATE_BURST=40

# ------------------------------------------------------------
# 审计日志（独立 SQLite，与业务库分离）
# ------------------------------------------------------------
# 不设置时默认 data/audit_log.db
# 独立存放的原因：业务库损坏/回滚时审计记录仍需保留
# GEO_DISTRIBUTOR_AUDIT_DB=/var/lib/geo-distributor/audit.db

# ------------------------------------------------------------
# API 文档暴露（仅排障时临时开启）
# ------------------------------------------------------------
# GEO_DISTRIBUTOR_EXPOSE_DOCS=1
