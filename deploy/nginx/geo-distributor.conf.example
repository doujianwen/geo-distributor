# ==========================================================================
# geo-distributor Nginx 反向代理配置示例
#
# 本文件是**模板**，不含任何真实域名 / 证书路径 / 密钥。
# 部署时复制到你的 nginx 配置目录并替换所有 PLACEHOLDER。
#
# 架构契约：
#   Internet ──HTTPS:443──> Reverse Proxy (nginx) ──HTTP:8765──> geo-distributor
#                                    │
#geo-distributor 仅监听 127.0.0.1，**绝不允许**直接暴露公网
#
# 为什么必须 TLS 终止在反代：
#   API Key 通过 X-API-Key 头传输。绕过 TLS = 明文传输密钥 = 等于没有认证。
# ==========================================================================

# --------------------------------------------------------------------------
# 0. 后端 upstream
# --------------------------------------------------------------------------
# geo-distributor 只监听回环地址，不做端口对外映射。
upstream geo_distributor_backend {
    server 127.0.0.1:8765;

    # 保持长连接，避免每次请求重建 TCP
    keepalive 32;
}

# --------------------------------------------------------------------------
# 1. HTTP → HTTPS 强制跳转
# --------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name api.PLACEHOLDER_DOMAIN;

    # ACME 质询路径需保持 HTTP（证书续签用）
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 308 https://$host$request_uri;
    }
}

# --------------------------------------------------------------------------
# 2. HTTPS 主服务
# --------------------------------------------------------------------------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.PLACEHOLDER_DOMAIN;

    # ---- TLS ----
    # 证书路径由部署方替换；本模板不含真实路径
    ssl_certificate     PLACEHOLDER_FULLCHAIN_PEM;
    ssl_certificate_key PLACEHOLDER_PRIVKEY_PEM;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # ---- 安全响应头 ----
    # geo-distributor 是 API，不加载任何页面，因此 CSP 可以极严
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "no-referrer" always;
    add_header Content-Security-Policy   "default-src 'none'; frame-ancestors 'none'" always;
    # 不暴露 nginx 版本
    server_tokens off;

    # ---- 请求体上限 ----
    # 采集结果可能较大，但不应无限制。8MB 足够覆盖 measurement 提交。
    client_max_body_size 8m;
    client_body_timeout 30s;
    client_header_timeout 15s;

    # ---- 访问日志：不记录敏感头 ----
    # 默认 log_format 不含 $http_authorization / $http_x_api_key，
    # 此处显式声明以防未来有人改 format 时误加。
    # X-API-Key 的值**永不进日志**。
    log_format geo_safe '$remote_addr - $remote_user [$time_local] '
                       '"$request" $status $body_bytes_sent '
                       '"$http_user_agent" rt=$request_time';
    access_log /var/log/nginx/geo-distributor.access.log geo_safe;
    error_log  /var/log/nginx/geo-distributor.error.log warn;

    # ---- 限流（第一层：按 IP，挡扫描器）----
    # 应用层还有第二层按 API Key 的限流。两层互补：
    #   nginx 按 IP → 挡住无凭证的扫描/爆破
    #   应用按 Key → 挡住单租户失控（nginx 看不到 API Key）
    # 必须在 application 层也有限流；两层缺一不可。
    limit_req_zone $binary_remote_addr zone=geo_ip:10m rate=20r/m;

    # ---- forwarded headers：覆盖而非追加 ----
    # 用 $remote_addr 而非 $proxy_add_x_forwarded_for —— 后者会把
    # 客户端伪造的 X-Forwarded-For 追加进去，污染可信链。
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header X-Forwarded-Port  $server_port;

    # ---- 反代超时策略 ----
    # measurement 端点可能耗时较久，故 read timeout 相对宽松；
    # 但必须有限值，避免连接被长期占用耗尽文件描述符。
    proxy_connect_timeout 10s;
    proxy_send_timeout    60s;
    proxy_read_timeout    120s;
    proxy_buffering       on;
    proxy_buffer_size     16k;
    proxy_buffers         8 16k;

    location / {
        limit_req zone=geo_ip burst=10 nodelay;

        proxy_pass http://geo_distributor_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }

    # ---- 健康检查：不记访问日志（高频轮询会淹没日志）----
    location = /health {
        access_log off;
        proxy_pass http://geo_distributor_backend;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 5s;
    }

    # ---- 显式拒绝文档端点 ----
    # 应用层已默认关闭，这里是**纵深防御**：即使应用层被误配置为开启，
    # 反代层也不放行。排查问题时需同时改两处。
    location ~ ^/(docs|redoc|openapi\.json) {
        return 404;
    }

    # ---- 拒绝隐藏文件与路径穿越尝试 ----
    location ~ /\. {
        deny all;
        return 404;
    }
}
